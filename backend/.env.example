# =================================================================
# TravelBuddy Backend Environment Configuration Template
# Copy this file to .env and set your local credentials.
# NEVER commit the actual .env file to Git.
# =================================================================

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Option A: Discrete connection parameters (Local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travelbuddy
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Option B: Connection URI (Cloud deployment: Neon, Railway, Render, Supabase)
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/travelbuddy
DATABASE_SSL=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated, used in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# AI Service (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_MODEL=qwen/qwen3.8-27b

# Geospatial & External APIs
GEOAPIFY_API_KEY=your_geoapify_api_key_here
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
OSM_USER_AGENT=TravelBuddy/1.0 (SIH 2026)

# Firebase Admin Service Account (Push Notifications / FCM)
# Place your service account JSON inside backend/secrets/ (ignored by Git)
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json

# IoT Sensor Telemetry
IOT_DEVICE_KEY=your_iot_device_key_here
IOT_STALE_TIMEOUT_MS=12000
