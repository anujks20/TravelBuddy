# =================================================================
# TravelBuddy Root .gitignore
# Protects sensitive secrets, build artifacts, and local environments
# across backend, mobile, web, iot, hotel-portal, and police-dashboard.
# =================================================================

# --------------------------------------------------
# 1. Environment & Secrets
# --------------------------------------------------
.env
.env.*
!.env.example
*.env
.env.local
.env.production
.env.development

# --------------------------------------------------
# 2. Firebase & Service Account Credentials
# --------------------------------------------------
service-account*.json
firebase-service-account*.json
*serviceAccountKey*.json
*firebase-adminsdk*.json
*.service-account.json
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
credentials/
secrets/
backend/secrets/
**/secrets/**
!*.example
!**/*.example

# --------------------------------------------------
# 3. Private Keys & Certificates
# --------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt

# --------------------------------------------------
# 4. IoT & Hardware Local Credentials
# --------------------------------------------------
iot/config.h
**/config.h
!**/config.h.example

# --------------------------------------------------
# 5. Node.js & Web Applications
# --------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
dist/
.turbo/
web/test.js

# --------------------------------------------------
# 6. Python Environments & Caches
# --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# --------------------------------------------------
# 7. Flutter & Dart Builds
# --------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
build/
*.iml

# --------------------------------------------------
# 8. Android Build & Keystores
# --------------------------------------------------
.gradle/
local.properties
*.jks
*.keystore
key.properties
captures/
.cxx/

# --------------------------------------------------
# 9. iOS / macOS / Ephemeral Flutter Artifacts
# --------------------------------------------------
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh

# --------------------------------------------------
# 10. PlatformIO & Embedded Builds
# --------------------------------------------------
.pio/

# --------------------------------------------------
# 11. Database Files & Local Dumps
# --------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
web/trips.db

# --------------------------------------------------
# 12. Temporary, Backup & Scratch Files
# --------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*~
*.backup
*.audit2.bak
scratch/

# --------------------------------------------------
# 13. IDE & Editor Configurations
# --------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# --------------------------------------------------
# 14. Operating System Files
# --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --------------------------------------------------
# 15. Log Files
# --------------------------------------------------
*.log
logs/
