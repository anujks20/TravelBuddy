# =================================================================
# TravelBuddy Web Portal Environment Configuration Template
# Copy this file to .env and set your credentials.
# NEVER commit the actual .env file to Git.
# =================================================================

# Server Port
PORT=3000

# Backend API Endpoint
TRAVELBUDDY_BACKEND_URL=http://localhost:5000

# Public Base URL (for webhooks and external callbacks)
PUBLIC_BASE_URL=http://localhost:3000

# AI Service (Groq API)
GROQ_API_KEY=your_groq_api_key_here

# Stock Imagery API (Pexels)
PEXELS_API_KEY=your_pexels_api_key_here

# WhatsApp Business Cloud API Integration
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=your_webhook_verification_token_here
